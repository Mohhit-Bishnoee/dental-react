{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/health.js": {
      "maxDuration": 10
    },
    "api/auth/session.js": {
      "maxDuration": 10
    },
    "api/auth/login.js": {
      "maxDuration": 10
    },
    "api/auth/logout.js": {
      "maxDuration": 10
    },
    "api/auth/password.js": {
      "maxDuration": 10
    },
    "api/content.js": {
      "maxDuration": 10
    },
    "api/uploads.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
